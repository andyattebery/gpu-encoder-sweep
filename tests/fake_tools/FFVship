#!/usr/bin/env python3
"""A fake FFVship: --version, and per-frame JSON for SSIMULACRA2 ([[s], ...]) or Butteraugli ([[q, 3, inf], ...])."""
import json
import os
import sys

argv = sys.argv[1:]
if "--version" in argv:
    print("FFVship v5.1.0 (CUDA)")
    sys.exit(0)
frames = int(os.environ.get("FAKE_FRAMES", "1439"))
metric = argv[argv.index("-m") + 1]
out = argv[argv.index("--json") + 1]
if metric == "SSIMULACRA2":
    rows = [[80.0 + (i % 10)] for i in range(frames)]
else:
    rows = [[1.0 + (i % 3) * 0.1, 1.5, 2.0 + (i % 7) * 0.1] for i in range(frames)]
with open(out, "w") as f:
    json.dump(rows, f)
