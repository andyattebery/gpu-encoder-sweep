# syntax=docker/dockerfile:1
# The hub: FastAPI + SQLite (the record), installed by uv from the lock. Runs on nas-01 behind traefik, Redis beside it.
# The same image runs the hub's own agent as a second service (`sweep-node serve`, SWEEP_HOST=nas-01): inventory
# probes the library where it is local, so it carries the nodes' jellyfin-ffmpeg build and the package's node extra.
# CI passes SETUPTOOLS_SCM_PRETEND_VERSION (the version the checkout reports), SWEEP_ARTIFACT (hub:<version>) and
# SWEEP_HARNESS_SHA; a build without them says so in /etc/sweep-artifact rather than inventing a version.
# linux/amd64 by intent: the portable ffmpeg is the linux64 build.
FROM --platform=linux/amd64 python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6
# the tag every node image pins (tests/test_images.py holds them equal): a different build under the hub's agent would
# be a different ffprobe than the one the nodes' identities name
ARG JELLYFIN_FFMPEG_TAG=v8.1.2-3+nvenc-n13.0.19.1
ARG JELLYFIN_FFMPEG_ASSET=jellyfin-ffmpeg_8.1.2-3-nvenc-n13.0.19.1_portable_linux64-gpl.tar.xz
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl xz-utils && rm -rf /var/lib/apt/lists/*
RUN mkdir -p /opt/jellyfin-ffmpeg/bin \
    && curl -fsSL "https://github.com/andyattebery/jellyfin-ffmpeg/releases/download/${JELLYFIN_FFMPEG_TAG}/${JELLYFIN_FFMPEG_ASSET}" | tar -xJ -C /opt/jellyfin-ffmpeg/bin \
    && /opt/jellyfin-ffmpeg/bin/ffmpeg -version > /dev/null      # no pipe: a pipe would hide a binary that cannot load
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
ARG SETUPTOOLS_SCM_PRETEND_VERSION=0+unbuilt
ARG SWEEP_ARTIFACT=hub:0+unbuilt
ARG SWEEP_HARNESS_SHA=unknown
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION} UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock README.md .python-version ./
COPY sweep ./sweep
RUN uv sync --locked --extra hub --extra node --no-dev --no-editable
RUN printf '%s\n%s\n' "$SWEEP_ARTIFACT" "$SWEEP_HARNESS_SHA" > /etc/sweep-artifact
ENV PATH="/app/.venv/bin:${PATH}" SWEEP_STORE=/data/hub.sqlite SWEEP_SHARE=/share SWEEP_FRAMES=/data/frames SWEEP_BIND=0.0.0.0:8000
VOLUME ["/data"]
EXPOSE 8000
# the agent service overrides this with `sweep-node serve`
ENTRYPOINT ["sweep-hub"]
