# syntax=docker/dockerfile:1
# The score node: FFVship (SSIMULACRA2, Butteraugli) at Vship v5.1.0 -- the version the committed values were scored
# with, pinned on purpose: a newer tag is a new scorer_build, which the acceptance comparison cannot be run across --
# built for CUDA from Codeberg (the source; GitHub is a stale mirror), plus the same jellyfin-ffmpeg (libvmaf_cuda),
# python via uv and the package's node extra. The base is ubuntu26.04 because FFVship v5.1.0 needs libavutil >= 7
# (ubuntu 24.04 ships 6.1.1 and the build fails after the nvcc work). ARCH=all: docker build has no GPU to detect, and
# the fat binary covers Ampere and Blackwell alike (the archived ffvship/Dockerfile.cuda).
FROM --platform=linux/amd64 nvidia/cuda:13.3.1-devel-ubuntu26.04 AS build
ARG VSHIP_TAG=v5.1.0
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git make pkg-config g++ libffms2-dev libavutil-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone --depth 1 --branch "${VSHIP_TAG}" https://codeberg.org/Line-fr/Vship.git .
RUN make build BACKEND=Cuda ARCH=all && make buildFFVSHIP

FROM --platform=linux/amd64 nvidia/cuda:13.3.1-runtime-ubuntu26.04@sha256:71b55b93449973f2ee6d8024d6dd34853d338a1f007fe07adaaf9a35fd591794
RUN apt-get update && apt-get install -y --no-install-recommends libffms2-5 ca-certificates curl xz-utils python3 && rm -rf /var/lib/apt/lists/*
COPY --from=build /src/FFVship /usr/local/bin/FFVship
COPY --from=build /src/libvship.so /usr/local/lib/libvship.so
RUN ldconfig
ARG JELLYFIN_FFMPEG_TAG=v8.1.2-3+nvenc-n13.0.19.1
ARG JELLYFIN_FFMPEG_ASSET=jellyfin-ffmpeg_8.1.2-3-nvenc-n13.0.19.1_portable_linux64-gpl.tar.xz
RUN mkdir -p /opt/jellyfin-ffmpeg/bin \
    && curl -fsSL "https://github.com/andyattebery/jellyfin-ffmpeg/releases/download/${JELLYFIN_FFMPEG_TAG}/${JELLYFIN_FFMPEG_ASSET}" | tar -xJ -C /opt/jellyfin-ffmpeg/bin \
    && /opt/jellyfin-ffmpeg/bin/ffmpeg -hide_banner -filters | grep -q libvmaf_cuda
COPY --from=ghcr.io/astral-sh/uv:0.12.10 /uv /uvx /bin/
ARG SETUPTOOLS_SCM_PRETEND_VERSION=0+unbuilt
ARG SWEEP_ARTIFACT=node-score:0+unbuilt
ARG SWEEP_HARNESS_SHA=unknown
# the base's own python3 (>= 3.11 satisfies the lock); no interpreter download, which under emulation fetches the wrong architecture
ENV SETUPTOOLS_SCM_PRETEND_VERSION=${SETUPTOOLS_SCM_PRETEND_VERSION} UV_PYTHON_DOWNLOADS=never UV_PYTHON=/usr/bin/python3
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY sweep ./sweep
RUN uv sync --locked --extra node --no-dev --no-editable
RUN printf '%s\n%s\n' "$SWEEP_ARTIFACT" "$SWEEP_HARNESS_SHA" > /etc/sweep-artifact
ENV PATH="/app/.venv/bin:${PATH}" NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility,video
ENTRYPOINT ["sweep-node", "serve"]
